{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-brand-os:artifact:2.3.0:context",
  "type": "object",
  "properties": {
    "artifactId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "artifactType": {
      "const": "PROMPT_CONTEXT"
    },
    "parentArtifactId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "conversationId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "organizationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "producingService": {
      "const": "CONTEXT_ENGINE"
    },
    "producingStage": {
      "const": "context"
    },
    "schemaVersion": {
      "const": "2.3.0"
    },
    "status": {
      "const": "VALID"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "variant": {
          "const": "context"
        },
        "operationStatus": {
          "const": "SUCCEEDED"
        },
        "brandId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "invocationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "attemptNumber": {
          "type": "integer",
          "minimum": 1
        },
        "checkpointNumber": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "type": "object",
          "properties": {
            "assemblyVersion": {
              "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/context/properties/assemblyVersion"
            },
            "retrievalStrategy": {
              "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/context/properties/retrievalStrategy"
            },
            "contextProfile": {
              "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/context/properties/contextProfile"
            },
            "selectedKnowledge": {
              "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/context/properties/selectedKnowledge"
            },
            "businessRules": {
              "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/context/properties/businessRules"
            },
            "brandVoice": {
              "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/context/properties/brandVoice"
            },
            "memory": {
              "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/context/properties/memory"
            },
            "evidence": {
              "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/context/properties/evidence"
            },
            "provenance": {
              "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/context/properties/provenance"
            },
            "contextScore": {
              "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/context/properties/contextScore"
            },
            "selectedRelationships": {
              "type": "array",
              "items": {
                "$ref": "urn:ai-brand-os:ontology-relations:1.0.0:context-reference"
              }
            },
            "relationshipSelection": {
              "type": "object",
              "properties": {
                "truncated": {
                  "type": "boolean"
                },
                "reason": {
                  "anyOf": [
                    {
                      "enum": [
                        "EDGE_LIMIT",
                        "NODE_LIMIT"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "truncated",
                "reason"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "truncated": {
                        "const": false
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "reason": {
                        "type": "null"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "reason": {
                        "enum": [
                          "EDGE_LIMIT",
                          "NODE_LIMIT"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "assemblyVersion",
            "retrievalStrategy",
            "contextProfile",
            "selectedKnowledge",
            "businessRules",
            "brandVoice",
            "memory",
            "evidence",
            "provenance",
            "contextScore",
            "selectedRelationships",
            "relationshipSelection"
          ],
          "additionalProperties": false
        },
        "error": {
          "type": "null"
        }
      },
      "required": [
        "variant",
        "operationStatus",
        "brandId",
        "invocationId",
        "attemptNumber",
        "checkpointNumber",
        "data",
        "error"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "artifactId",
    "artifactType",
    "parentArtifactId",
    "conversationId",
    "correlationId",
    "organizationId",
    "producingService",
    "producingStage",
    "schemaVersion",
    "status",
    "createdAt",
    "payload"
  ],
  "additionalProperties": false
}

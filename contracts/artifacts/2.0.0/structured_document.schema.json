{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-brand-os:artifact:2.0.0:STRUCTURED_DOCUMENT",
  "title": "STRUCTURED_DOCUMENT payload 2.0.0",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "variant": {
          "const": "structured_document"
        },
        "operationStatus": {
          "enum": [
            "PENDING",
            "PARTIAL",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "TIMEOUT"
          ]
        },
        "brandId": {
          "type": "string",
          "format": "uuid"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/processingData"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceDocumentId": {
          "type": "string",
          "format": "uuid"
        },
        "invocationId": {
          "type": "string",
          "format": "uuid"
        },
        "attemptNumber": {
          "type": "integer",
          "minimum": 1
        },
        "checkpointNumber": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "variant",
        "operationStatus",
        "brandId",
        "data",
        "error",
        "sourceDocumentId",
        "invocationId",
        "attemptNumber",
        "checkpointNumber"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operationStatus": {
                "const": "SUCCEEDED"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/processingData"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operationStatus": {
                "const": "PENDING"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operationStatus": {
                "const": "PARTIAL"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/processingFragment"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operationStatus": {
                "enum": [
                  "FAILED",
                  "CANCELLED",
                  "TIMEOUT"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "anyOf": [
                  {
                    "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/processingFragment"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {
                "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/error"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operationStatus": {
                "const": "CANCELLED"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "properties": {
                  "code": {
                    "const": "CANCELLED"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operationStatus": {
                "const": "TIMEOUT"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "properties": {
                  "code": {
                    "const": "TIMEOUT"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operationStatus": {
                "const": "FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "properties": {
                  "code": {
                    "not": {
                      "enum": [
                        "CANCELLED",
                        "TIMEOUT"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}

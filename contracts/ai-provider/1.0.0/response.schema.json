{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-brand-os:ai-provider:1.0.0:response",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "invocationId": {
      "type": "string",
      "format": "uuid"
    },
    "purpose": {
      "enum": [
        "KNOWLEDGE_EXTRACTION",
        "WORKSPACE_GENERATION"
      ]
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "TIMEOUT"
      ]
    },
    "providerKey": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "modelKey": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "output": {
      "anyOf": [
        {
          "oneOf": [
            {
              "$ref": "urn:ai-brand-os:ai-provider:1.0.0:common#/$defs/extractionOutput"
            },
            {
              "$ref": "urn:ai-brand-os:ai-provider:1.0.0:common#/$defs/generationOutput"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "enum": [
            "MEASURED",
            "ESTIMATED",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "basis"
      ],
      "additionalProperties": false
    },
    "estimatedCost": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "latencyMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "promptTemplateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "promptTemplateVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "policyRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "physicalAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "regionKey": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "priceVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "vendorRequestDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "externalChargePossible": {
          "type": "boolean"
        }
      },
      "required": [
        "physicalAttempts",
        "regionKey",
        "priceVersion",
        "vendorRequestDigest",
        "externalChargePossible"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "invocationId",
    "purpose",
    "status",
    "providerKey",
    "modelKey",
    "output",
    "error",
    "usage",
    "estimatedCost",
    "latencyMs",
    "promptTemplateId",
    "promptTemplateVersion",
    "policyRef",
    "execution"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "providerKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "modelKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "output": {
            "oneOf": [
              {
                "$ref": "urn:ai-brand-os:ai-provider:1.0.0:common#/$defs/extractionOutput"
              },
              {
                "$ref": "urn:ai-brand-os:ai-provider:1.0.0:common#/$defs/generationOutput"
              }
            ]
          },
          "error": {
            "type": "null"
          },
          "execution": {
            "properties": {
              "physicalAttempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "output": {
            "type": "null"
          },
          "error": {
            "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "KNOWLEDGE_EXTRACTION"
          }
        }
      },
      "then": {
        "properties": {
          "output": {
            "anyOf": [
              {
                "$ref": "urn:ai-brand-os:ai-provider:1.0.0:common#/$defs/extractionOutput"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "output": {
            "anyOf": [
              {
                "$ref": "urn:ai-brand-os:ai-provider:1.0.0:common#/$defs/generationOutput"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "usage": {
            "properties": {
              "basis": {
                "const": "UNKNOWN"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "usage": {
            "properties": {
              "inputTokens": {
                "type": "null"
              },
              "outputTokens": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "TIMEOUT"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "TIMEOUT"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "CANCELLED"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "CANCELLED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "usage": {
            "properties": {
              "basis": {
                "enum": [
                  "MEASURED",
                  "ESTIMATED"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "usage": {
            "anyOf": [
              {
                "properties": {
                  "inputTokens": {
                    "type": "integer"
                  }
                }
              },
              {
                "properties": {
                  "outputTokens": {
                    "type": "integer"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-brand-os:ai-provider:1.0.0:request",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "invocationId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "organizationId": {
      "type": "string",
      "format": "uuid"
    },
    "brandId": {
      "type": "string",
      "format": "uuid"
    },
    "purpose": {
      "enum": [
        "KNOWLEDGE_EXTRACTION",
        "WORKSPACE_GENERATION"
      ]
    },
    "caller": {
      "enum": [
        "KNOWLEDGE_EXTRACTION",
        "AI_ORCHESTRATOR"
      ]
    },
    "promptTemplateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "promptTemplateVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "trustedInstructionRef": {
      "type": "object",
      "properties": {
        "registryKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "registryKey",
        "sha256"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "evidenceId": {
                "type": "string",
                "format": "uuid"
              },
              "sourceArtifactId": {
                "type": "string",
                "format": "uuid"
              },
              "sourceDocumentId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "evidenceId",
              "sourceArtifactId",
              "sourceDocumentId"
            ],
            "additionalProperties": false
          },
          "maxItems": 128
        },
        "requestedFieldRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 128
        },
        "dataClassification": {
          "enum": [
            "BUSINESS_INTERNAL",
            "SENSITIVE_REVIEWED"
          ]
        }
      },
      "required": [
        "content",
        "evidence",
        "requestedFieldRefs",
        "dataClassification"
      ],
      "additionalProperties": false
    },
    "expectedOutputSchemaRef": {
      "enum": [
        "urn:ai-brand-os:ai-provider:1.0.0:extraction-output",
        "urn:ai-brand-os:ai-provider:1.0.0:generation-output"
      ]
    },
    "requirements": {
      "type": "object",
      "properties": {
        "capabilityKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "enum": [
              "STRUCTURED_JSON",
              "TEXT"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "requestedModelKey": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "capabilityKey",
        "requiredCapabilities",
        "requestedModelKey"
      ],
      "additionalProperties": false
    },
    "policyRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxInputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxPhysicalAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxCost": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "maxInputTokens",
        "maxOutputTokens",
        "maxOutputBytes",
        "timeoutMs",
        "maxPhysicalAttempts",
        "maxCost"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "attemptNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "idempotencyKey": {
          "type": "string",
          "format": "uuid"
        },
        "requestHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "attemptNumber",
        "idempotencyKey",
        "requestHash"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "deadlineAt": {
          "type": "string",
          "format": "date-time"
        },
        "cancellationId": {
          "type": "string",
          "format": "uuid"
        },
        "workRef": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "IMPORT",
                "MESSAGE"
              ]
            },
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "sourceArtifactId": {
              "type": "string",
              "format": "uuid"
            },
            "jobId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "leaseFence": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "id",
            "sourceArtifactId",
            "jobId",
            "leaseFence"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "properties": {
                "jobId": {
                  "type": "null"
                },
                "leaseFence": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "jobId": {
                  "type": "string",
                  "format": "uuid"
                },
                "leaseFence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          ]
        }
      },
      "required": [
        "deadlineAt",
        "cancellationId",
        "workRef"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "invocationId",
    "correlationId",
    "organizationId",
    "brandId",
    "purpose",
    "caller",
    "promptTemplateId",
    "promptTemplateVersion",
    "trustedInstructionRef",
    "task",
    "expectedOutputSchemaRef",
    "requirements",
    "policyRef",
    "limits",
    "attempt",
    "execution"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "KNOWLEDGE_EXTRACTION"
          }
        }
      },
      "then": {
        "properties": {
          "caller": {
            "const": "KNOWLEDGE_EXTRACTION"
          },
          "expectedOutputSchemaRef": {
            "const": "urn:ai-brand-os:ai-provider:1.0.0:extraction-output"
          },
          "requirements": {
            "properties": {
              "requestedModelKey": {
                "type": "null"
              },
              "requiredCapabilities": {
                "contains": {
                  "const": "STRUCTURED_JSON"
                }
              }
            }
          },
          "execution": {
            "properties": {
              "workRef": {
                "properties": {
                  "kind": {
                    "const": "IMPORT"
                  },
                  "jobId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "leaseFence": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "WORKSPACE_GENERATION"
          }
        }
      },
      "then": {
        "properties": {
          "caller": {
            "const": "AI_ORCHESTRATOR"
          },
          "expectedOutputSchemaRef": {
            "const": "urn:ai-brand-os:ai-provider:1.0.0:generation-output"
          },
          "requirements": {
            "properties": {
              "requestedModelKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "requiredCapabilities": {
                "contains": {
                  "const": "TEXT"
                }
              }
            }
          },
          "execution": {
            "properties": {
              "workRef": {
                "properties": {
                  "kind": {
                    "const": "MESSAGE"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}

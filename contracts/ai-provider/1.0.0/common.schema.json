{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-brand-os:ai-provider:1.0.0:common",
  "$defs": {
    "money": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxInputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxPhysicalAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxCost": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "maxInputTokens",
        "maxOutputTokens",
        "maxOutputBytes",
        "timeoutMs",
        "maxPhysicalAttempts",
        "maxCost"
      ],
      "additionalProperties": false
    },
    "extractionOutput": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "EXTRACTION_PROPOSALS"
        },
        "proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fieldRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "evidenceId": {
                "type": "string",
                "format": "uuid"
              },
              "value": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16000
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                ]
              },
              "confidenceIndicator": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "fieldRef",
              "evidenceId",
              "value",
              "confidenceIndicator"
            ],
            "additionalProperties": false
          },
          "maxItems": 128
        }
      },
      "required": [
        "kind",
        "proposals"
      ],
      "additionalProperties": false
    },
    "generationOutput": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "GENERATED_TEXT"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "additionalProperties": false
    },
    "error": {
      "$ref": "urn:ai-brand-os:artifact:2.0.0:common#/$defs/error"
    }
  }
}

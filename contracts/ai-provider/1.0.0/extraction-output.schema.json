{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-brand-os:ai-provider:1.0.0:extraction-output",
  "type": "object",
  "properties": {
    "kind": {
      "const": "EXTRACTION_PROPOSALS"
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "evidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "value": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "minItems": 1,
                "maxItems": 32
              }
            ]
          },
          "confidenceIndicator": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "fieldRef",
          "evidenceId",
          "value",
          "confidenceIndicator"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    }
  },
  "required": [
    "kind",
    "proposals"
  ],
  "additionalProperties": false
}

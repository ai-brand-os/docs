{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-brand-os:knowledge-quality:1.0.0:field-value",
  "type": "object",
  "properties": {
    "state": {
      "enum": [
        "KNOWN",
        "UNKNOWN",
        "NOT_EVALUATED",
        "UNAVAILABLE",
        "NOT_APPLICABLE",
        "INVALID"
      ]
    },
    "value": {},
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "state",
    "value",
    "reasons"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "KNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "not": {
              "type": "null"
            }
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "null"
          },
          "reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

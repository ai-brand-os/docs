// Canonical MVP scope: MVP_SCOPE.md. Planned schema, not implementation evidence.
// Measurement authority: PRODUCT_METRICS.md; v2 field weights, readiness separate; targets are goals.
// Field provenance/version design: KNOWLEDGE_PROVENANCE.md; approved artifacts hold canonical values.
// Deletion/retention design: DATA_LIFECYCLE.md; intervals await legal/operational approval.
// Commercial authority: COMMERCIAL_PACKAGING.md; all prices are hypotheses.
// MVP: one owned Organization and Brand per account; Owner-only access.
// Starter/Pro labels grant the same fixed limits; no Agency subscription/portfolio.
// Per-account Organization limits are enforced transactionally in application services.
// Retained membership/role structures do not expose team collaboration.
// Phase 2 export design: domain/06_FUTURE_EXPORT_DESIGN.md; no export storage in MVP.
// ============================================================
// AI Brand OS — Database Schema (Prisma) — MERGED (Passes 1–3)
// Source of truth: domain/01_DOMAIN_MODEL.md, domain/02_ARTIFACT_MODEL.md,
//                  domain/03_BUSINESS_ONTOLOGY.md, prd/01_BRAND_BRAIN_PRD.md,
//                  prd/02_AI_WORKSPACE_PRD.md
// Merge date: 2026-07-07
// Merge changes vs. the three pass files (structural only, no semantic changes):
//   - Added required back-relations (Prisma relations are mandatory two-sided):
//       Organization  -> artifacts, products, services, audiences,
//                        competitors, documents, knowledgeIndex, conversations
//       Brand         -> knowledgeIndex, conversations
//   - Consolidated all "post-migration raw SQL" notes into one section at
//     the end of this file.
//   - MessageStatus is the per-Message generation lifecycle, as specified
//     in the AI Workspace PRD State Management section.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ============================================================
// Platform Services (not part of Core Domain — see Product Bible Layer 3)
// ============================================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships   OrganizationMember[] // relational multi-membership capacity is Phase 2; MVP permits sole Owner membership
  conversations Conversation[]
  approvedBrainRevisions BrandBrainRevision[] @relation("BrainRevisionApprover")

  @@map("users")
}

// OrgRole values beyond OWNER are reserved for Phase 2; no shared access in MVP.
// Role list follows Engineering Bible (Owner/Admin/Editor/Viewer) as the
// canonical source, per reconciliation with AI Workspace PRD.
// Canonical enum per Engineering Bible; MVP permits OWNER only, other roles Phase 2.
enum OrgRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Organization {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  industry        Industry
  companySize     CompanySize @map("company_size")
  websiteUrl      String?     @map("website_url")
  primaryRegion   String      @map("primary_region")
  primaryLanguage String      @map("primary_language")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  members         OrganizationMember[]

  // MVP: at most 1 Brand row during setup, exactly 1 after onboarding.
  // Every proposed Starter/Pro offer preserves this uniqueness; Agency is Phase 2.
  // Enforced here via @unique on Brand.organizationId (see below).
  // Per Business Ontology cardinality note: this becomes 1:N in Phase 2
  // (multi-brand) — that change requires an ontology MINOR version bump,
  // not just a schema migration.
  brand           Brand?

  artifacts       Artifact[]
  products        Product[]
  services        Service[]
  audiences       Audience[]
  competitors     Competitor[]
  documents       Document[]
  knowledgeIndex  KnowledgeIndex[]
  conversations   Conversation[]
  conversationPurges ConversationPurge[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           OrgRole
  createdAt      DateTime @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId]) // one role per org; NOT an Agency entitlement or cross-org product grant
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

// ============================================================
// Controlled Vocabularies
// Source: domain/03_BUSINESS_ONTOLOGY.md — Controlled Vocabulary Registry
// Versioning note: these are PATCH-level per Ontology ADR-002. Adding a
// value here does NOT require Founder approval, only Architecture review —
// but it IS a schema migration (Postgres enums require ALTER TYPE).
// ============================================================

enum CompanySize {
  SIZE_1_5
  SIZE_6_20
  SIZE_21_50
  SIZE_50_PLUS
}

enum Industry {
  ECOMMERCE_RETAIL
  PROFESSIONAL_SERVICES
  SAAS_TECHNOLOGY
  HEALTH_WELLNESS
  FOOD_BEVERAGE
  EDUCATION_COACHING
  REAL_ESTATE
  FINANCE_INSURANCE
  MARKETING_CREATIVE_AGENCIES
  FASHION_APPAREL
  BEAUTY_PERSONAL_CARE
  HOME_LIFESTYLE
  TRAVEL_HOSPITALITY
  NONPROFIT_COMMUNITY
  MANUFACTURING_INDUSTRIAL
  OTHER
}

enum ToneAttribute {
  PROFESSIONAL
  FRIENDLY
  BOLD
  PLAYFUL
  AUTHORITATIVE
  MINIMAL
  EMPATHETIC
  CONFIDENT
  WITTY
  FORMAL
  WARM
  DIRECT
}

enum PrimaryGoal {
  AWARENESS
  LEAD_GEN
  SALES
  RETENTION
  OTHER
}

// ============================================================
// Core Domain — Brand
// Source: prd/01_BRAND_BRAIN_PRD.md §2, domain/03_BUSINESS_ONTOLOGY.md
// "Business Goals" modeled as attribute group on Brand per Ontology ADR-003
// (Confirmed Decision, not standalone entity).
// ============================================================

enum BrandStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Brand {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @unique @map("organization_id") @db.Uuid
  status            BrandStatus  @default(DRAFT)
  name              String
  missionStatement  String       @map("mission_statement") // PRD: <=300 chars, enforce at app layer
  visionStatement   String?      @map("vision_statement")  // PRD: <=300 chars, enforce at app layer
  coreValues        String[]     @default([]) @map("core_values")
  sampleWriting     String?      @map("sample_writing") @db.Text

  // Business Goals attribute group (Ontology ADR-003)
  primaryGoal       PrimaryGoal? @map("primary_goal")
  successDefinition String?      @map("success_definition")

  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandVoice        BrandVoice?

  currentRevisionId String? @unique @map("current_revision_id") @db.Uuid
  currentRevision BrandBrainRevision? @relation("CurrentBrainRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  revisions BrandBrainRevision[] @relation("BrainRevisionHistory")

  knowledgeIndex    KnowledgeIndex[]
  conversations     Conversation[]

  @@map("brands")
}

model BrandVoice {
  id              String          @id @default(uuid()) @db.Uuid
  brandId         String          @unique @map("brand_id") @db.Uuid
  toneAttributes  ToneAttribute[] @map("tone_attributes")
  vocabularyDos   String[]        @default([]) @map("vocabulary_dos")
  vocabularyDonts String[]        @default([]) @map("vocabulary_donts")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  brand           Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("brand_voices")
}

// ============================================================
// Unified Artifact Pipeline
//
// Design decision: ONE polymorphic table, not seven.
// Reason: 02_ARTIFACT_MODEL.md ADR-001 explicitly defines a single Base
// Artifact Contract shared by all 6 producing services specifically so
// that lineage-tracing and observability tooling is built once. Seven
// separate tables would duplicate the base columns seven times and
// contradict that ADR. Postgres JSONB (the reason PostgreSQL was chosen
// over MySQL, per Engineering Bible ADR 2026-07-02) is exactly the right
// tool for the type-specific `payload` field this table needs.
// ============================================================

enum ArtifactType {
  RAW_INTAKE
  PROCESSING_INTERMEDIATE // one of the 9 Document Processing pipeline stages
  STRUCTURED_DOCUMENT     // final output of Document Processing
  KNOWLEDGE_CANDIDATE
  APPROVED_KNOWLEDGE
  PROMPT_CONTEXT
  PROMPT
  RESPONSE
}

enum ProducingService {
  INGESTION
  DOCUMENT_PROCESSING
  KNOWLEDGE_EXTRACTION
  KNOWLEDGE_MANAGEMENT
  CONTEXT_ENGINE
  AI_ORCHESTRATOR
}

enum ArtifactStatus {
  CREATED
  VALID
  INVALID
  SUPERSEDED
  ARCHIVED
}

model Artifact {
  id               String           @id @default(uuid()) @db.Uuid
  artifactType     ArtifactType     @map("artifact_type")
  parentArtifactId String?          @map("parent_artifact_id") @db.Uuid // lineage reference, never a deletion ownership boundary
  conversationId   String?          @map("conversation_id") @db.Uuid // required by app for generation artifacts; null for independent knowledge/source artifacts
  correlationId    String           @map("correlation_id") @db.Uuid    // stable per import/generation operation; not a purge boundary
  organizationId   String           @map("organization_id") @db.Uuid
  producingService ProducingService @map("producing_service")
  producingStage   String           @map("producing_stage")
  schemaVersion    String           @map("schema_version") // semver, e.g. "1.0.0"
  status           ArtifactStatus   @default(CREATED)
  payload          Json             // type-specific structure — see Artifact Type Catalog in domain/02_ARTIFACT_MODEL.md
  createdAt        DateTime         @default(now()) @map("created_at")

  parent           Artifact?  @relation("ArtifactLineage", fields: [parentArtifactId], references: [id], onDelete: Restrict)
  children         Artifact[] @relation("ArtifactLineage")
  conversation     Conversation? @relation("ConversationArtifacts", fields: [conversationId], references: [id], onDelete: Restrict)
  responseMessages Message[] @relation("MessageResponseArtifact")
  brainRevision BrandBrainRevision? @relation("BrainRevisionArtifact")
  materializedProducts Product[] @relation("ProductMaterialization")
  materializedServices Service[] @relation("ServiceMaterialization")
  materializedAudiences Audience[] @relation("AudienceMaterialization")
  materializedCompetitors Competitor[] @relation("CompetitorMaterialization")
  latestForDocuments Document[] @relation("DocumentLatestArtifact")
  latestForKnowledge KnowledgeIndex[] @relation("KnowledgeLatestArtifact")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([correlationId])
  @@index([organizationId, artifactType])
  @@index([parentArtifactId])
  @@index([organizationId, conversationId])
  @@map("artifacts")
}

// ============================================================
// Core Domain Business Entities — projections of Brand.currentRevisionId.
// Canonical per-field values/origin/approval history live in the approved
// Artifact payload, indexed by BrandBrainRevision (KNOWLEDGE_PROVENANCE.md).
// sourceArtifactId is a restricted last-materialization pointer, not field origin.
// No independent RecordSource/source labels; mutation only in approval transaction.
// ============================================================

model Product {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  name              String
  description       String       @db.Text
  valueProposition  String       @map("value_proposition") @db.Text
  keyFeatures       String[]     @default([]) @map("key_features")
  pricingModel      String?      @map("pricing_model")
  sourceArtifactId  String?      @map("source_artifact_id") @db.Uuid // last projection materialization; field origin is in snapshot
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sourceArtifact Artifact? @relation("ProductMaterialization", fields: [sourceArtifactId], references: [id], onDelete: Restrict)

  @@index([sourceArtifactId])
  @@index([organizationId])
  @@map("products")
}

model Service {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  name              String
  description       String       @db.Text
  valueProposition  String       @map("value_proposition") @db.Text
  keyFeatures       String[]     @default([]) @map("key_features")
  pricingModel      String?      @map("pricing_model")
  sourceArtifactId  String?      @map("source_artifact_id") @db.Uuid // last projection materialization; field origin is in snapshot
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sourceArtifact Artifact? @relation("ServiceMaterialization", fields: [sourceArtifactId], references: [id], onDelete: Restrict)

  @@index([sourceArtifactId])
  @@index([organizationId])
  @@map("services")
}

model Audience {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  segmentName      String       @map("segment_name")
  description      String       @db.Text
  painPoints       String[]     @map("pain_points")
  goals            String[]     @default([])
  sourceArtifactId String?      @map("source_artifact_id") @db.Uuid // last projection materialization; field origin is in snapshot
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sourceArtifact Artifact? @relation("AudienceMaterialization", fields: [sourceArtifactId], references: [id], onDelete: Restrict)

  @@index([sourceArtifactId])
  @@index([organizationId])
  @@map("audiences")
}

model Competitor {
  id                    String       @id @default(uuid()) @db.Uuid
  organizationId        String       @map("organization_id") @db.Uuid
  name                  String?
  website               String?
  differentiationNotes  String?      @map("differentiation_notes") @db.Text
  sourceArtifactId      String?      @map("source_artifact_id") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sourceArtifact Artifact? @relation("CompetitorMaterialization", fields: [sourceArtifactId], references: [id], onDelete: Restrict)

  @@index([sourceArtifactId])
  @@index([organizationId])
  @@map("competitors")
}

enum DocumentSourceType {
  UPLOAD
  URL
}

enum DocumentProcessingStatus {
  IMPORTED
  PROCESSED
  EXTRACTED
  ARCHIVED
}

model Document {
  id                     String                    @id @default(uuid()) @db.Uuid
  organizationId         String                    @map("organization_id") @db.Uuid
  correlationId          String                    @map("correlation_id") @db.Uuid // ties this Document to its full Artifact chain
  sourceType             DocumentSourceType        @map("source_type")
  originalFilenameOrUrl  String                    @map("original_filename_or_url")
  processingStatus       DocumentProcessingStatus  @default(IMPORTED) @map("processing_status")
  latestArtifactId       String?                   @map("latest_artifact_id") @db.Uuid // points at current STRUCTURED_DOCUMENT artifact
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  latestArtifact Artifact? @relation("DocumentLatestArtifact", fields: [latestArtifactId], references: [id], onDelete: Restrict)

  @@index([latestArtifactId])
  @@index([organizationId])
  @@index([correlationId])
  @@map("documents")
}

// ============================================================
// Knowledge Index — entity retrieval projection of the selected approved snapshot.
// No independent approval/version lifecycle or alternate fact-value authority.
// Unique per Brand/entity, with a restricted current approved Artifact pointer.
// History, approval and score metadata use BrandBrainRevision; fact values and
// per-field provenance use that revision's immutable Artifact payload.
// ============================================================

enum KnowledgeEntityType {
  ORGANIZATION
  BRAND
  BRAND_VOICE
  PRODUCT
  SERVICE
  AUDIENCE
  COMPETITOR
  DOCUMENT
  // Reserved types (Persona, Content, Campaign, Asset, Channel) are
  // deliberately excluded here per Ontology: "Candidates referencing a
  // Reserved entity type fail Ontology Validation and are routed to
  // Reject." They must never reach this table.
}

model KnowledgeIndex {
  id                  String              @id @default(uuid()) @db.Uuid
  organizationId      String              @map("organization_id") @db.Uuid
  brandId             String              @map("brand_id") @db.Uuid
  describesEntityType KnowledgeEntityType @map("describes_entity_type")
  describesEntityId   String              @map("describes_entity_id") @db.Uuid // polymorphic FK — no DB-level referential integrity possible across tables; enforced at service layer
  knowledgeConfidence Int                 @map("knowledge_confidence") // 0-100
  ontologyVersion     String              @map("ontology_version")
  latestArtifactId    String              @map("latest_artifact_id") @db.Uuid // current APPROVED_KNOWLEDGE artifact
  status              ArtifactStatus      @default(VALID)                     // reuses artifact lifecycle states
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand               Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  latestArtifact Artifact @relation("KnowledgeLatestArtifact", fields: [latestArtifactId], references: [id], onDelete: Restrict)

  @@unique([brandId, describesEntityType, describesEntityId])
  @@index([latestArtifactId])
  @@index([organizationId, brandId])
  @@index([describesEntityType, describesEntityId])
  @@map("knowledge_index")
}

// Approved revision metadata + persisted completeness; values are NOT copied here.
// Draft/rejected proposals stay in KNOWLEDGE_CANDIDATE artifacts.
// JSON source/Document/input-fact references use the shared validation/locking and
// reference-aware erasure gateway specified in KNOWLEDGE_PROVENANCE.md.
// previous/restored/current links must be same Brand; app validates acyclicity.
model BrandBrainRevision {
  id                     String @id @default(uuid()) @db.Uuid
  brandId                String @map("brand_id") @db.Uuid
  revisionNumber         Int @map("revision_number")
  artifactId             String @unique @map("artifact_id") @db.Uuid
  previousRevisionId     String? @map("previous_revision_id") @db.Uuid
  restoredFromRevisionId String? @map("restored_from_revision_id") @db.Uuid
  approvedByUserId       String @map("approved_by_user_id") @db.Uuid
  approvedAt             DateTime @map("approved_at")
  changeReason           String @map("change_reason")
  ontologyVersion        String @map("ontology_version")
  calculationVersion     String @map("calculation_version") // current v2; preserve historical v1 snapshots
  calculatedAt           DateTime @map("calculated_at")
  completenessScore      Int @map("completeness_score") // 0..100 weighted v2; >=70 never bypasses mandatory fields; SQL check required
  missingMandatoryFields String[] @map("missing_mandatory_fields")
  readyForGeneration     Boolean @map("ready_for_generation") // approval-time business readiness, not live request authorization
  readinessReasons       String[] @map("readiness_reasons")

  brand Brand @relation("BrainRevisionHistory", fields: [brandId], references: [id], onDelete: Restrict)
  currentForBrand Brand? @relation("CurrentBrainRevision")
  artifact Artifact @relation("BrainRevisionArtifact", fields: [artifactId], references: [id], onDelete: Restrict)
  approvedBy User @relation("BrainRevisionApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  previousRevision BrandBrainRevision? @relation("BrainRevisionPrevious", fields: [previousRevisionId], references: [id], onDelete: Restrict)
  nextRevisions BrandBrainRevision[] @relation("BrainRevisionPrevious")
  restoredFromRevision BrandBrainRevision? @relation("BrainRevisionRestore", fields: [restoredFromRevisionId], references: [id], onDelete: Restrict)
  restorations BrandBrainRevision[] @relation("BrainRevisionRestore")

  @@unique([brandId, revisionNumber])
  @@index([brandId, approvedAt])
  @@index([approvedByUserId])
  @@index([previousRevisionId])
  @@index([restoredFromRevisionId])
  @@map("brand_brain_revisions")
}

// ============================================================
// AI Workspace Domain
// Source: 02_AI_WORKSPACE_PRD.md, domain/02_ARTIFACT_MODEL.md
// Two intentional, now-reconciled deviations from a literal early-draft PRD
// reading: no WorkspaceSession table and no AIRequest/AIResponse tables
// (both map onto the unified artifacts table — see 02_AI_WORKSPACE_PRD.md
// Domain Model and domain/04_DATABASE_DESIGN.md ADR-003 / ADR-004).
// MessageStatus models the per-Message generation lifecycle — see its
// enum comment below.
// ============================================================

enum MessageRole {
  USER
  ASSISTANT
}

// Individual ASSISTANT Message generation attempt only; reconciled with
// prd/02_AI_WORKSPACE_PRD.md State Management and Database Design ADR-008.
// COMPLETED/FAILED/CANCELLED/TIMEOUT are terminal for this attempt, never
// for its persistent multi-turn Conversation. USER Messages store COMPLETED.
// New ASSISTANT placeholders explicitly start DRAFT (do not use default).
// No terminal reset: retry creates a new assistant Message/correlationId.
enum MessageStatus {
  DRAFT
  SUBMITTING
  QUEUED
  PREPARING_CONTEXT
  GENERATING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}

enum FeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

// Persistent multi-turn container: Active (deletedAt=null) -> pending physical
// deletion (deletedAt!=null) -> verified purge/removal. No generation status.
// A terminal assistant Message never terminates its parent; see ADR-008.
model Conversation {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  brandId         String    @map("brand_id") @db.Uuid // BR-002: exactly one Brand
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  title           String?   // auto-generated from first message if null
  lastActivityAt  DateTime  @default(now()) @map("last_activity_at") // FR-006: ordered by latest activity
  deletedAt       DateTime? @map("deleted_at") // tombstone: inaccessible, pending physical deletion; not erasure completion
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // MVP Brand removal is archival. Restrict also prevents any future
  // hard deletion from bypassing owned Conversation/artifact cleanup.
  brand           Brand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  messages        Message[]
  generationArtifacts Artifact[] @relation("ConversationArtifacts")

  @@index([organizationId, brandId])
  @@index([createdByUserId])
  @@index([lastActivityAt])
  @@index([deletedAt])
  @@map("conversations")
}

model Message {
  id                 String        @id @default(uuid()) @db.Uuid
  conversationId     String        @map("conversation_id") @db.Uuid
  role               MessageRole
  content            String        @db.Text // denormalized final text — avoids reading artifacts.payload JSONB on every render
  status             MessageStatus @default(COMPLETED) // USER accepted -> COMPLETED; ASSISTANT must explicitly start DRAFT; per-attempt lifecycle only
  correlationId      String?       @map("correlation_id") @db.Uuid // set on submit; links this turn's full artifact chain
  responseArtifactId String?       @map("response_artifact_id") @db.Uuid // restricted FK into artifacts; app enforces RESPONSE, same tenant/Conversation, ASSISTANT only
  isLowContext       Boolean       @default(false) @map("is_low_context") // EC-004: Context Engine returned no context
  createdAt          DateTime      @default(now()) @map("created_at")

  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback           Feedback?
  responseArtifact   Artifact? @relation("MessageResponseArtifact", fields: [responseArtifactId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([correlationId])
  @@map("messages")
}

model Feedback {
  id        String         @id @default(uuid()) @db.Uuid
  messageId String         @unique @map("message_id") @db.Uuid // @unique enforces "duplicate voting is prevented" (FR-010) — MVP is single-user per conversation, no per-user vote tracking needed (multi-user collaboration is an explicit Non-Goal)
  rating    FeedbackRating
  createdAt DateTime       @default(now()) @map("created_at")

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

// Durable deletion request / minimal receipt. Independent of Conversation so
// physical removal cannot erase retries/evidence. No user content in this model.
// conversationId is intentionally a scalar, NOT a Conversation FK.
// App enforces same tenant, deletion transaction, 30-day proposed target,
// lease recovery, holds and completion verification; see DATA_LIFECYCLE.md.
enum ConversationPurgeStatus {
  PENDING
  RUNNING
  RETRY_REQUIRED
  BLOCKED
  EXCEPTION
  COMPLETED
}

model ConversationPurge {
  id                 String @id @default(uuid()) @db.Uuid
  organizationId     String @map("organization_id") @db.Uuid
  conversationId     String @unique @map("conversation_id") @db.Uuid
  requestedByUserId  String? @map("requested_by_user_id") @db.Uuid // minimal audit identifier; no cascading User relation
  requestedAt        DateTime @map("requested_at") // original Conversation.deletedAt; never reset by retries
  targetPurgeAt      DateTime @map("target_purge_at") // proposed requestedAt + 30 days, subject to approval
  status             ConversationPurgeStatus @default(PENDING)
  attemptCount       Int @default(0) @map("attempt_count")
  nextAttemptAt      DateTime? @map("next_attempt_at")
  lockedAt           DateTime? @map("locked_at") // worker lease; app validates expiry/claim token
  leaseToken         String? @map("lease_token") @db.Uuid
  lastErrorCode      String? @map("last_error_code") // bounded safe code; never raw payload/error text
  exceptionRef       String? @map("exception_ref") // reference to separately authorized hold record
  reviewAt           DateTime? @map("review_at")
  manifestRef        String? @map("manifest_ref") // private operational manifest: resource IDs/steps only
  completedAt        DateTime? @map("completed_at") // verified active removal, not backup erasure
  receiptExpiresAt   DateTime? @map("receipt_expires_at") // approved receipt policy; no automatic deletion while backup replay needs it
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([targetPurgeAt])
  @@index([organizationId])
  @@map("conversation_purges")
}

